[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.editor.x86_64 = "res://addons/ghostty-terminal/lib/libghostty_terminal.linux.editor.x86_64.so"
windows.editor.x86_64 = "res://addons/ghostty-terminal/lib/ghostty_terminal.windows.editor.x86_64.dll"
macos.editor = "res://addons/ghostty-terminal/lib/libghostty_terminal.macos.editor.dylib"
